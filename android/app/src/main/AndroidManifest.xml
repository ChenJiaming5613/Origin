<?xml version="1.0" encoding="utf-8"?>
<!-- 基于 SDL3 官方 android-project 模板裁剪而来。
     Activity 上那几个属性不是可选的装饰：SDLActivity 依赖
     launchMode/configChanges 的具体取值来正确处理生命周期与配置变更，
     改动前请先读 SDL 的 README-android.md。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="1.0"
    android:installLocation="auto">

    <!-- 声明需要 Vulkan 1.3。required=true 让不满足的设备在商店侧被过滤，
         避免装上去直接启动失败。
         0x403000 = VK_MAKE_VERSION(1,3,0)，与 Android 的
         PackageManager.FEATURE_VULKAN_HARDWARE_VERSION 对 1.3 的取值一致。

         为什么要 1.3 而不是原先的 1.0.3（0x400003）：本工程用 dynamic
         rendering，该特性在 1.3 才进核心。注意这条声明和 build.gradle 里的
         minSdk 33 是**两道独立的过滤**，都需要：
           minSdk    管的是 Android 版本（1.3 从 API 33 起才暴露）
           这条声明   管的是设备驱动能力（Android 13 的机器也可能只有 1.1 驱动）
         少了后者，Android 13 上的老 GPU 装得上但启动就抛异常。 -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x403000"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:version="0"
        android:required="true" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- 直接使用 org.libsdl.app.SDLActivity，因此本工程零 Java 文件。
             该类不在本仓库里：app/build.gradle 的 sourceSets 把
             third_party/SDL/android-project/app/src/main/java 加进了 java.srcDirs，
             编译时从 submodule 源码取，SDL 升级自动同步。

             SDLActivity 继承的是 android.app.Activity，不依赖任何 androidx，
             所以既不需要 appcompat 依赖，也不受 Theme.AppCompat 主题约束。

             SDLActivity.getLibraries() 默认返回 {"SDL3", "main"}，
             这就是 CMake 目标必须命名为 main（产出 libmain.so）的原因。
             若要改库名或加自定义逻辑，需自建一个继承 SDLActivity 的 Java 类并重写该方法。

             刻意**不写** android:screenOrientation —— 写了也没用。
             SDL 在 SDL_CreateWindow 时会调 Android_JNI_SetOrientation()，
             进而执行 setRequestedOrientation()，在运行时覆盖 Manifest 的取值：
             窗口带 SDL_WINDOW_RESIZABLE 且未设 SDL_HINT_ORIENTATIONS 时，
             SDL 请求的是 SCREEN_ORIENTATION_FULL_USER（允许所有方向，
             同时尊重用户的「屏幕旋转锁定」系统开关）。
             见 SDLActivity.java 的 setOrientationBis()。
             要真正锁方向应在 C++ 侧设 hint，例如：
               SDL_SetHint(SDL_HINT_ORIENTATIONS, "Portrait"); -->
        <activity
            android:name="org.libsdl.app.SDLActivity"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
